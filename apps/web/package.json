{
  "name": "exfuzzy-atlas-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ExFuzzy Atlas web client (AT-050, prototype against the mock API)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:static": "tsc --noEmit && vite build --mode static",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:landing-maps": "node scripts/gen-landing-maps.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "maplibre-gl": "6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
