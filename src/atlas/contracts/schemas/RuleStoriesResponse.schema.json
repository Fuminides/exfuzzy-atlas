{
  "$defs": {
    "RuleStory": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "description": "Counts over the query results that reproduce numbers.",
          "items": {
            "$ref": "#/$defs/StoryCheck"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/StoryKind"
        },
        "numbers": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "Every number quoted in the text.",
          "title": "Numbers",
          "type": "object"
        },
        "queries": {
          "items": {
            "$ref": "#/$defs/StoryQuery"
          },
          "minItems": 1,
          "title": "Queries",
          "type": "array"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "score": {
          "description": "Interestingness used for ranking (see RuleStoriesResponse.score_definition).",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "story_id": {
          "description": "Deterministic: kind, rule and anchor.",
          "title": "Story Id",
          "type": "string"
        },
        "text": {
          "description": "Template-built statement about activations. Never a cause or an explanation.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "story_id",
        "kind",
        "rule_id",
        "text",
        "score",
        "numbers",
        "queries",
        "checks"
      ],
      "title": "RuleStory",
      "type": "object"
    },
    "StoryCheck": {
      "additionalProperties": false,
      "description": "Machine-checkable claim: count the features of ``queries[query]`` whose property satisfies ``op``.",
      "properties": {
        "expected": {
          "description": "The number of features that must satisfy it.",
          "minimum": 0,
          "title": "Expected",
          "type": "integer"
        },
        "op": {
          "enum": [
            "gte",
            "eq",
            "not_null"
          ],
          "title": "Op",
          "type": "string"
        },
        "operand": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Right-hand side of gte/eq; null for not_null.",
          "title": "Operand"
        },
        "property": {
          "description": "Key of Feature.properties, e.g. value, dominant_rule_id or n_valid.",
          "title": "Property",
          "type": "string"
        },
        "query": {
          "description": "Index into the story's queries.",
          "minimum": 0,
          "title": "Query",
          "type": "integer"
        }
      },
      "required": [
        "query",
        "property",
        "op",
        "expected"
      ],
      "title": "StoryCheck",
      "type": "object"
    },
    "StoryKind": {
      "enum": [
        "co_activation_burst",
        "localized_rule",
        "territory_leader"
      ],
      "title": "StoryKind",
      "type": "string"
    },
    "StoryQuery": {
      "additionalProperties": false,
      "description": "A request that returns the data a story is computed from.",
      "properties": {
        "method": {
          "const": "GET",
          "default": "GET",
          "title": "Method",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Params",
          "type": "object"
        },
        "path": {
          "enum": [
            "/api/v1/rule-map",
            "/api/v1/rule-territories"
          ],
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "params"
      ],
      "title": "StoryQuery",
      "type": "object"
    }
  },
  "$id": "https://exfuzzy-atlas/schemas/0.8.0/RuleStoriesResponse.schema.json",
  "additionalProperties": false,
  "properties": {
    "data_version": {
      "title": "Data Version",
      "type": "string"
    },
    "disclaimer": {
      "default": "Descripciones de activaciones del modelo en la ventana pedida.",
      "title": "Disclaimer",
      "type": "string"
    },
    "limit": {
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "n_candidates": {
      "description": "Stories found before the cap.",
      "minimum": 0,
      "title": "N Candidates",
      "type": "integer"
    },
    "schema_version": {
      "default": "0.8.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score_definition": {
      "title": "Score Definition",
      "type": "string"
    },
    "stories": {
      "items": {
        "$ref": "#/$defs/RuleStory"
      },
      "title": "Stories",
      "type": "array"
    },
    "synthetic": {
      "default": false,
      "description": "True for fixtures; the UI must label them as synthetic.",
      "title": "Synthetic",
      "type": "boolean"
    },
    "tau": {
      "exclusiveMinimum": 0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Tau",
      "type": "number"
    },
    "time_from_utc": {
      "format": "date-time",
      "title": "Time From Utc",
      "type": "string"
    },
    "time_to_utc": {
      "format": "date-time",
      "title": "Time To Utc",
      "type": "string"
    }
  },
  "required": [
    "data_version",
    "model_id",
    "time_from_utc",
    "time_to_utc",
    "tau",
    "limit",
    "n_candidates",
    "score_definition",
    "stories"
  ],
  "title": "RuleStoriesResponse",
  "type": "object"
}
