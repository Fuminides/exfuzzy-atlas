{
  "$defs": {
    "Attribution": {
      "additionalProperties": false,
      "description": "Credit and licence of a data source (v0.4); the text is what a redistribution must show.",
      "properties": {
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Licence name; null when the source declares none (say so in text).",
          "title": "License"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.6.1: the same credit in English; the UI shows it when the interface is in English, else falls back to `text`. The licence and the URL are the same in both languages.",
          "title": "Text En"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "text"
      ],
      "title": "Attribution",
      "type": "object"
    },
    "Domain": {
      "enum": [
        "air",
        "water",
        "mobility",
        "fnirs"
      ],
      "title": "Domain",
      "type": "string"
    },
    "MetricRow": {
      "additionalProperties": false,
      "properties": {
        "estimator": {
          "title": "Estimator",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "slice": {
          "default": "all",
          "title": "Slice",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "estimator",
        "metric",
        "value",
        "n"
      ],
      "title": "MetricRow",
      "type": "object"
    },
    "SchemeKind": {
      "description": "What a classification scheme is (v0.4); the UI words the classes differently for each.",
      "enum": [
        "official_index",
        "percentile_reference",
        "analytical"
      ],
      "title": "SchemeKind",
      "type": "string"
    },
    "SubjectSplit": {
      "additionalProperties": false,
      "description": "Split by subject: no subject has rows in two parts. Selection folds are groups of training subjects.",
      "properties": {
        "selection_folds": {
          "default": [],
          "description": "Training subjects held out in each cross-validation fold of the configuration search.",
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Selection Folds",
          "type": "array"
        },
        "selection_metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Metric the search maximised (mean over folds).",
          "title": "Selection Metric"
        },
        "test_subjects": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Test Subjects",
          "type": "array"
        },
        "train_subjects": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Train Subjects",
          "type": "array"
        }
      },
      "required": [
        "train_subjects",
        "test_subjects"
      ],
      "title": "SubjectSplit",
      "type": "object"
    },
    "TargetClass": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Official colour, if any.",
          "title": "Color"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "description_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.6: English version of `description`; the UI shows it when the interface is in English, else falls back to `description`.",
          "title": "Description En"
        },
        "display_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.5.1: name shown in the UI language when the official `label` is in another one, e.g. EAQI 'Good' -> 'Buena'. `label` stays the key and the official name.",
          "title": "Display Label"
        },
        "display_label_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.6: English display name of the class, e.g. ICA 'Buena' -> 'Good' (EAQI: its own official name); the UI shows it when the interface is in English, else falls back to `display_label` (then `label`).",
          "title": "Display Label En"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lower bound in the scheme unit; null = unbounded.",
          "title": "Lower"
        },
        "merged_from": {
          "default": [],
          "description": "v0.4: labels of the official classes this one groups (e.g. ICA 'Desfavorable o peor').",
          "items": {
            "type": "string"
          },
          "title": "Merged From",
          "type": "array"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Upper bound in the scheme unit; null = unbounded.",
          "title": "Upper"
        }
      },
      "required": [
        "label",
        "lower",
        "upper"
      ],
      "title": "TargetClass",
      "type": "object"
    },
    "TargetScheme": {
      "additionalProperties": false,
      "description": "Ordered categories of a classification target, taken from a cited source (e.g. an official index).",
      "properties": {
        "boundary": {
          "default": "lower_inclusive",
          "description": "Which bound a value exactly on a boundary belongs to.",
          "enum": [
            "lower_inclusive",
            "upper_inclusive"
          ],
          "title": "Boundary",
          "type": "string"
        },
        "classes": {
          "items": {
            "$ref": "#/$defs/TargetClass"
          },
          "minItems": 2,
          "title": "Classes",
          "type": "array"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchemeKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.4: official index, percentile reference or analytical."
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "name_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.6: English display name of the scheme; the UI shows it when the interface is in English, else falls back to `name`.",
          "title": "Name En"
        },
        "short_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.4: compact name for legends, e.g. 'ICA'.",
          "title": "Short Name"
        },
        "short_name_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.6: English compact name, e.g. 'Relative level' for 'Nivel relativo'; the UI shows it when the interface is in English, else falls back to `short_name`.",
          "title": "Short Name En"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source_url",
        "unit",
        "classes"
      ],
      "title": "TargetScheme",
      "type": "object"
    }
  },
  "$id": "https://exfuzzy-atlas/schemas/0.9.0/FnirsModelCard.schema.json",
  "additionalProperties": false,
  "description": "``GET /fnirs/card?model_id=``: provenance, split and metrics of a montage task's model (a ``ModelCard`` whose\nsplit is by subject instead of by period).",
  "properties": {
    "attribution": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Attribution"
      },
      "title": "Attribution",
      "type": "array"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "data_checksums": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Data Checksums",
      "type": "object"
    },
    "data_version": {
      "title": "Data Version",
      "type": "string"
    },
    "domain": {
      "$ref": "#/$defs/Domain"
    },
    "exfuzzy_version": {
      "title": "Exfuzzy Version",
      "type": "string"
    },
    "features": {
      "items": {
        "type": "string"
      },
      "title": "Features",
      "type": "array"
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Git Commit"
    },
    "git_dirty": {
      "title": "Git Dirty",
      "type": "boolean"
    },
    "hyperparameters": {
      "additionalProperties": true,
      "title": "Hyperparameters",
      "type": "object"
    },
    "metrics": {
      "description": "slice 'test', 'train' or 'validation' (mean over the selection folds); for error bars also 'test/seed=<k>' (every estimator refitted with seed k on the same split), 'validation/fold=<k>' (one subject fold of the selection) and 'nested/fold=<k>' (subject-grouped cross-validation over every subject: outer group k as test, the configuration chosen again without it, mean over the seeds). Estimator 'exfuzzy' is the served model (under 'nested', the same procedure), the others are baselines.",
      "items": {
        "$ref": "#/$defs/MetricRow"
      },
      "title": "Metrics",
      "type": "array"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "python_version": {
      "title": "Python Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "split": {
      "$ref": "#/$defs/SubjectSplit"
    },
    "synthetic": {
      "default": false,
      "description": "True for fixtures; the UI must label them as synthetic.",
      "title": "Synthetic",
      "type": "boolean"
    },
    "target": {
      "title": "Target",
      "type": "string"
    },
    "target_scheme": {
      "$ref": "#/$defs/TargetScheme"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "data_version",
    "model_id",
    "task_id",
    "domain",
    "run_id",
    "created_at_utc",
    "git_commit",
    "git_dirty",
    "exfuzzy_version",
    "python_version",
    "seed",
    "target",
    "features",
    "hyperparameters",
    "data_checksums",
    "split",
    "target_scheme",
    "metrics"
  ],
  "title": "FnirsModelCard",
  "type": "object"
}
