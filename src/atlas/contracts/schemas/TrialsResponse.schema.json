{
  "$defs": {
    "MissingReason": {
      "enum": [
        "no_observation",
        "invalid_observation",
        "censored",
        "missing_input",
        "prediction_unavailable",
        "not_modelled"
      ],
      "title": "MissingReason",
      "type": "string"
    },
    "TrialRecord": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "description": "What the block was in the source (e.g. '3-back'); data, not translated.",
          "title": "Condition",
          "type": "string"
        },
        "missing_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/MissingReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_label": {
          "title": "Observed Label",
          "type": "string"
        },
        "predicted_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Predicted Label"
        },
        "sample_id": {
          "description": "Unique row id, e.g. 's03-t05'.",
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Sample Id",
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "integer"
        },
        "top_rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule mixture: the rule that supports the prediction the most.",
          "title": "Top Rule Id"
        },
        "trial": {
          "description": "Order of the block within the subject's recording.",
          "minimum": 1,
          "title": "Trial",
          "type": "integer"
        },
        "winning_rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Winning-rule classifier: the rule that decided.",
          "title": "Winning Rule Id"
        }
      },
      "required": [
        "sample_id",
        "subject",
        "trial",
        "condition",
        "split",
        "observed_label",
        "predicted_label"
      ],
      "title": "TrialRecord",
      "type": "object"
    }
  },
  "$id": "https://exfuzzy-atlas/schemas/0.9.0/TrialsResponse.schema.json",
  "additionalProperties": false,
  "description": "``GET /fnirs/trials?model_id=``: every published row of a montage task, test subjects included and marked.",
  "properties": {
    "data_version": {
      "title": "Data Version",
      "type": "string"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "description": "True for fixtures; the UI must label them as synthetic.",
      "title": "Synthetic",
      "type": "boolean"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/TrialRecord"
      },
      "title": "Trials",
      "type": "array"
    }
  },
  "required": [
    "data_version",
    "model_id",
    "task_id",
    "trials"
  ],
  "title": "TrialsResponse",
  "type": "object"
}
