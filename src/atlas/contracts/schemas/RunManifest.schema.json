{
  "$defs": {
    "Domain": {
      "enum": [
        "air",
        "water",
        "mobility"
      ],
      "title": "Domain",
      "type": "string"
    },
    "SplitSpec": {
      "additionalProperties": false,
      "description": "Chronological split. Periods are half-open [from, to) and must not overlap.",
      "properties": {
        "embargo_hours": {
          "description": "Gap between consecutive periods, at least the horizon.",
          "minimum": 0,
          "title": "Embargo Hours",
          "type": "integer"
        },
        "test_from_utc": {
          "format": "date-time",
          "title": "Test From Utc",
          "type": "string"
        },
        "test_to_utc": {
          "format": "date-time",
          "title": "Test To Utc",
          "type": "string"
        },
        "train_from_utc": {
          "format": "date-time",
          "title": "Train From Utc",
          "type": "string"
        },
        "train_to_utc": {
          "format": "date-time",
          "title": "Train To Utc",
          "type": "string"
        },
        "validation_from_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation From Utc"
        },
        "validation_to_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation To Utc"
        }
      },
      "required": [
        "train_from_utc",
        "train_to_utc",
        "test_from_utc",
        "test_to_utc",
        "embargo_hours"
      ],
      "title": "SplitSpec",
      "type": "object"
    }
  },
  "$id": "https://exfuzzy-atlas/schemas/0.8.0/RunManifest.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Name -> path relative to the run directory.",
      "title": "Artifacts",
      "type": "object"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "data_checksums": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Data Checksums",
      "type": "object"
    },
    "data_version": {
      "title": "Data Version",
      "type": "string"
    },
    "domain": {
      "$ref": "#/$defs/Domain"
    },
    "exfuzzy_version": {
      "title": "Exfuzzy Version",
      "type": "string"
    },
    "features": {
      "items": {
        "type": "string"
      },
      "title": "Features",
      "type": "array"
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Git Commit"
    },
    "git_dirty": {
      "title": "Git Dirty",
      "type": "boolean"
    },
    "horizon_hours": {
      "description": "0 for same-time inference (no forecast).",
      "minimum": 0,
      "title": "Horizon Hours",
      "type": "integer"
    },
    "hyperparameters": {
      "additionalProperties": true,
      "title": "Hyperparameters",
      "type": "object"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "python_version": {
      "title": "Python Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.8.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "split": {
      "$ref": "#/$defs/SplitSpec"
    },
    "target": {
      "title": "Target",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "model_id",
    "task_id",
    "domain",
    "created_at_utc",
    "git_commit",
    "git_dirty",
    "exfuzzy_version",
    "python_version",
    "seed",
    "split",
    "data_version",
    "data_checksums",
    "target",
    "horizon_hours",
    "features",
    "hyperparameters",
    "artifacts"
  ],
  "title": "RunManifest",
  "type": "object"
}
